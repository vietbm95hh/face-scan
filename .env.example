# ---- PostgreSQL (server dev) ----
# Điền host/port/user/password của PostgreSQL trên server dev.
# Đổi sang 127.0.0.1 / 2024 nếu muốn dùng cluster local của máy này.
PG_HOST=100.69.209.48
PG_PORT=5432
PG_DB=fbscan
PG_USER=postgres
PG_PASSWORD=your_password
# Giây chờ kết nối tối đa (server dev ở xa -> không treo khi mạng rớt)
PG_CONNECT_TIMEOUT=10
# Tailscale/DERP chập chờn: thử lại kết nối trước khi báo lỗi
PG_CONNECT_RETRIES=2
PG_CONNECT_BACKOFF=1.0

# ---- Facebook ----
FB_COOKIES_FILE=facebook_cookies.json

# ---- Quét ----
REQUEST_DELAY_SEC=1.0
GROUP_DELAY_MIN=5
GROUP_DELAY_MAX=15
MAX_AGE_DAYS=7
STOP_AFTER_SEEN=10
MAX_POSTS_PER_GROUP=0

# ---- Media ----
DOWNLOAD_MEDIA=1
MAX_MEDIA_MB=15

# ---- API ----
API_HOST=127.0.0.1
API_PORT=8000

DEBUG=1
